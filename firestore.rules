rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Discoveries: anyone signed in (including anonymous) can read the live
    // feed and post new discoveries. Only the reactionCount field may be
    // updated after creation — everything else about a discovery is
    // immutable once posted, and only its own creator may delete it.
    match /discoveries/{discoveryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']);
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // One reaction doc per discovery per user — its existence is the
      // "have I already reacted" record, keyed by uid so it can't be spoofed.
      match /reactions/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Saved spots: every user can only ever read or write their own
    // saved list — this is what makes "saved spots follow you around"
    // safe without a real login system.
    match /users/{uid}/saved/{discoveryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
